---
import PhotoGrid from "../components/PhotoGrid.astro";
import Base from "../layouts/Base.astro";
import { loadStudio } from "../lib/content";

const { studio, gear } = (await loadStudio()).data;
---

<Base
  title="Le studio"
  description="Le studio des Productions du Chauve et son matériel."
>
  <section class="container page-head">
    <h1>Le studio</h1>
    <div class="prose" set:html={studio.text} />
    <PhotoGrid photos={studio.photos} alt="Le studio" />
  </section>

  <section class="section">
    <div class="container">
      <h2>Le matériel</h2>
      <div class="prose" set:html={gear.text} />
      <PhotoGrid photos={gear.photos} alt="Le matériel" />
    </div>
  </section>
</Base>
