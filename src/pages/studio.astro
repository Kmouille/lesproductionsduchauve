---
import { Image } from "astro:assets";
import GearSheet from "../components/GearSheet.astro";
import Base from "../layouts/Base.astro";
import { loadStudio } from "../lib/content";

const studio = (await loadStudio()).data;
---

<Base
  title="Le studio"
  description="Le studio des Productions du Chauve et son matériel."
>
  <section class="container page-head">
    <h1>Le studio</h1>
    <div class="prose" set:html={studio.intro} />
  </section>

  {studio.gallery.length > 0 && (
    <section class="section">
      <div class="container grid">
        {studio.gallery.map((photo, index) => (
          <Image
            src={photo}
            alt={`Le studio, photo ${index + 1}`}
            widths={[400, 800]}
            sizes="(min-width: 64rem) 25vw, (min-width: 40rem) 33vw, 50vw"
            class="studio__photo"
          />
        ))}
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <h2>Le matériel</h2>
      <GearSheet gear={studio.gear} />
    </div>
  </section>
</Base>

<style>
  :global(.studio__photo) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
</style>
