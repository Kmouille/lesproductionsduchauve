---
import { Image } from "astro:assets";
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import { loadAbout } from "../lib/content";

const about = await loadAbout();
const { Content } = await render(about);
---

<Base title="Qui suis-je" description="L'histoire des Productions du Chauve.">
  <section class="container page-head about">
    <Image
      src={about.data.portrait}
      alt="Yves dans le studio des Productions du Chauve"
      widths={[600, 1000, 1400]}
      sizes="(min-width: 48rem) 45vw, 100vw"
      class="about__portrait"
      loading="eager"
    />
    <div>
      <h1>{about.data.title}</h1>
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
</Base>

<style>
  .about {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 48rem) {
    .about {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  :global(.about__portrait) {
    width: 100%;
    height: auto;
  }
</style>
