---

<footer id="contact" class="footer">
  <div class="container footer__inner">
    <div>
      <p class="kicker">Contact</p>
      <a class="footer__mail" href={`mailto:${email}`}>
        {email}
      </a>
    </div>
    <ul class="footer__socials">
      {socials.map((social) => (
        <li>
          <a
            class="footer__social"
            href={social.url}
            rel="me noopener"
            target="_blank"
            aria-label={social.name}
            title={social.name}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d={ICON_PATHS[matchSocialIcon(social.url)]} />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <p class="container footer__legal muted">
    © {new Date().getFullYear()} Les Productions du Chauve
  </p>
</footer>

<style>
  .footer {
    margin-top: 4rem;
    padding-block: 3rem 1.5rem;
    border-top: 1px solid var(--line);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
  }

  .footer__mail {
    font-size: clamp(1.6rem, 5vw, 3rem);
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .footer__mail:hover {
    text-decoration: underline;
  }

  .footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .footer__social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--cream);
    border-radius: 50%;
    color: var(--cream);
  }

  .footer__social:hover,
  .footer__social:focus-visible {
    background: var(--cream);
    color: var(--black);
  }

  .footer__social svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: currentColor;
  }

  .footer__legal {
    margin-top: 2rem;
    font-size: 0.75rem;
  }
</style>
