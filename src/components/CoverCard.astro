---
import { Picture } from "astro:assets";
import type { ProductionEntry } from "../lib/content";
import { ROLE_LABELS } from "../lib/taxonomy";

interface Props {
  production: ProductionEntry;
  sizes: string;
  eager?: boolean;
}

const { production, sizes, eager = false } = Astro.props;
const { data, slug } = production;
const meta = [
  String(data.releaseDate.getFullYear()),
  ...data.roles.map((role) => ROLE_LABELS[role]),
].join(" / ");
---

<article
  class="cover-card"
  data-roles={data.roles.join(" ")}
  data-genres={data.genres.join(" ")}
>
  <a class="cover-card__link" href={`/productions/${slug}/`}>
    <div class="cover-card__cover">
      <Picture
        src={data.cover}
        alt={`Pochette de ${data.title}, ${data.artist}`}
        formats={["avif", "webp"]}
        widths={[400, 600, 800]}
        sizes={sizes}
        loading={eager ? "eager" : "lazy"}
      />
      <div class="cover-card__overlay" aria-hidden="true">
        <p class="cover-card__artist display">{data.artist}</p>
        <p class="cover-card__summary">{data.summary}</p>
        <p class="kicker">{meta}</p>
      </div>
      {data.draft && <span class="tag cover-card__draft">Brouillon</span>}
    </div>
    <p class="cover-card__caption">
      <strong>{data.title}</strong>
      <span class="muted">{data.artist}</span>
    </p>
  </a>
</article>

<style>
  .cover-card[hidden] {
    display: none;
  }

  .cover-card__link {
    display: block;
    text-decoration: none;
  }

  .cover-card__cover {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .cover-card__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter 0.3s;
  }

  .cover-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 0.9rem;
    border: 1px solid var(--cream);
    background: rgb(0 0 0 / 78%);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .cover-card__overlay p {
    margin: 0;
  }

  .cover-card__artist {
    font-size: 1.5rem;
  }

  .cover-card__summary {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.82rem;
    line-height: 1.4;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
  }

  .cover-card__link:is(:hover, :focus-visible) :global(img) {
    filter: grayscale(1) contrast(1.3);
  }

  .cover-card__link:is(:hover, :focus-visible) .cover-card__overlay {
    opacity: 1;
  }

  .cover-card__draft {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    background: var(--black);
  }

  .cover-card__caption {
    display: grid;
    margin: 0.55rem 0 0;
    font-size: 0.8rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-card__cover :global(img),
    .cover-card__overlay {
      transition: none;
    }
  }
</style>
