---
import type { ImageMetadata } from "astro";
import { getImage, Picture } from "astro:assets";

interface Props {
  cover: ImageMetadata;
  alt: string;
}

const { cover, alt } = Astro.props;
const full = await getImage({
  src: cover,
  width: Math.min(2400, cover.width),
  format: "webp",
  quality: 90,
});
---

<div class="viewer-host">
  <button
    type="button"
    class="viewer-trigger"
    data-viewer-open
    aria-label={`Agrandir : ${alt}`}
  >
    <Picture
      src={cover}
      alt={alt}
      formats={["avif", "webp"]}
      widths={[600, 900, 1200]}
      sizes="(min-width: 48rem) 50vw, 100vw"
      loading="eager"
      fetchpriority="high"
    />
    <span class="kicker viewer-trigger__hint">Agrandir</span>
  </button>
  <dialog class="viewer" data-viewer data-src={full.src} aria-label={alt}>
    <button type="button" class="btn viewer__close" data-viewer-close>
      Fermer
    </button>
    <img class="viewer__img" alt={alt} />
  </dialog>
</div>

<style>
  .viewer-trigger {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .viewer-trigger :global(img) {
    width: 100%;
    height: auto;
  }

  .viewer-trigger__hint {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    margin: 0;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--line);
    background: var(--black);
  }

  .viewer {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: auto;
    background: rgb(0 0 0 / 96%);
  }

  .viewer::backdrop {
    background: rgb(0 0 0 / 80%);
  }

  .viewer__close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 1;
  }

  .viewer__img {
    max-width: 100%;
    max-height: 100vh;
    margin: auto;
    object-fit: contain;
    cursor: zoom-in;
  }

  .viewer__img.is-actual-size {
    max-width: none;
    max-height: none;
    cursor: zoom-out;
  }
</style>

<script>
  for (const host of document.querySelectorAll<HTMLElement>(".viewer-host")) {
    const dialog = host.querySelector<HTMLDialogElement>("[data-viewer]");
    const image = host.querySelector<HTMLImageElement>(".viewer__img");
    const open = host.querySelector<HTMLButtonElement>("[data-viewer-open]");
    const close = host.querySelector<HTMLButtonElement>("[data-viewer-close]");
    if (!dialog || !image || !open || !close) {
      continue;
    }
    open.addEventListener("click", () => {
      if (!image.getAttribute("src")) {
        image.src = dialog.dataset.src ?? "";
      }
      dialog.showModal();
    });
    close.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });
    image.addEventListener("click", () =>
      image.classList.toggle("is-actual-size"),
    );
  }
</script>
