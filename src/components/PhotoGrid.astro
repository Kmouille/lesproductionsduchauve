---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  photos: ImageMetadata[];
  alt: string;
}

const { photos, alt } = Astro.props;
---

{photos.length > 0 && (
  <div class="grid photo-grid">
    {photos.map((photo, index) => (
      <Image
        src={photo}
        alt={`${alt}, photo ${index + 1}`}
        widths={[400, 800]}
        sizes="(min-width: 64rem) 25vw, (min-width: 40rem) 33vw, 50vw"
        class="photo-grid__photo"
      />
    ))}
  </div>
)}

<style>
  .photo-grid {
    margin-top: var(--gutter);
  }

  :global(.photo-grid__photo) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
</style>
